name: YouTube Live Scraper

on:
  schedule:
    # 每天一次（台灣時間中午 12:00）
    - cron: '0 4 * * *'
  workflow_dispatch:

permissions:
  contents: write
  actions: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # 🔹每次安裝最新版 yt-dlp Nightly
      - name: Install yt-dlp Nightly
        run: |
          python -m pip install --upgrade pip
          pip uninstall -y yt-dlp
          pip install -U --pre "yt-dlp[default]"

      # 🔹執行抓直播
      - name: Run fetch_lives.py
        env:
          # 🔹統一使用 PAT（可跨 repo push）
          GH_TOKEN: ${{ secrets.TARGET_REPO_TOKEN }}
        run: python fetch_lives.py

      # 🔹更新 live_list.txt 並通知 1150217-2
      - name: Commit and Push live_list.txt + Trigger M3U Update
        env:
          # 🔹這裡也統一使用 PAT
          GH_TOKEN: ${{ secrets.TARGET_REPO_TOKEN }}
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

          git add live_list.txt

          # 只在 live_list.txt 有變動時才 commit & push
          if ! git diff --staged --quiet; then

            git commit -m "Auto update live list"

            git push

            echo "✅ live_list.txt 已 commit & push"

            # 🔹發送 repository_dispatch
            curl -X POST \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: token $GH_TOKEN" \
              https://api.github.com/repos/rico08101214/1150217-2/dispatches \
              -d '{"event_type":"live_list_updated"}'

            echo "🚀 已通知 1150217-2 更新 M3U"

          else

            echo "⚠️ live_list.txt 無變動，跳過 commit & dispatch"

          fi
